rules_version = '2';

// ─── Ma Finance OS — Storage Security Rules ──────────────────────────────────
// Users can only read/write their own avatar folder. Public read of avatars is
// allowed so profile images render; writes are owner-only and size/type-checked.

service firebase.storage {
  match /b/{bucket}/o {
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
